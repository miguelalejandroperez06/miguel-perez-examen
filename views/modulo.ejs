<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= titulo %> - TecnoStore</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">TecnoStore</a>
            <div class="navbar-nav ms-auto">
                <a class="nav-link" href="/vista/equipos">Equipos</a>
                <a class="nav-link" href="/vista/proveedores">Proveedores</a>
                <a class="nav-link" href="/vista/clientes">Clientes</a>
                <a class="nav-link" href="/vista/ventas">Ventas</a>
                <a class="btn btn-outline-light btn-sm ms-2" href="/vista/login">Login</a>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2>Gestión de <%= titulo %></h2>
            <span id="badgeRol" class="badge bg-secondary">Sin sesión</span>
        </div>

        <div id="mensaje"></div>

        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead class="table-dark" id="tablaHead"></thead>
                        <tbody id="tablaBody">
                            <tr><td class="text-center">Cargando datos...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script>
        const endpoint = '<%= endpoint %>';
        const token = localStorage.getItem('token');
        const rol = localStorage.getItem('rol');

        if (rol) {
            document.getElementById('badgeRol').textContent = 'Rol activo: ' + rol;
            document.getElementById('badgeRol').className = 'badge bg-success';
        }

        async function cargarDatos() {
            const headers = token ? { 'Authorization': 'Bearer ' + token } : {};
            const res = await fetch(endpoint, { headers });
            const json = await res.json();

            if (!res.ok) {
                document.getElementById('mensaje').innerHTML = `<div class="alert alert-warning">${json.message}</div>`;
                document.getElementById('tablaBody').innerHTML = '';
                return;
            }

            const lista = json.data || [];
            if (lista.length === 0) {
                document.getElementById('tablaBody').innerHTML = '<tr><td>No hay registros disponibles.</td></tr>';
                return;
            }

            const columnas = Object.keys(lista[0]);
            document.getElementById('tablaHead').innerHTML = '<tr>' + columnas.map(c => `<th>${c.toUpperCase()}</th>`).join('') + '</tr>';
            document.getElementById('tablaBody').innerHTML = lista.map(fila =>
                '<tr>' + columnas.map(c => `<td>${fila[c] ?? '-'}</td>`).join('') + '</tr>'
            ).join('');
        }

        cargarDatos();
    </script>
</body>
</html>